# Copy this file to .env and fill in real values before deploying.
# NEVER commit the real .env file to version control.

# Django
SECRET_KEY=-RkHkVA6oSQJvhccsI-DxdlDGKuPHdtVyLWyFHGU3SM
# DEBUG=True gives helpful error pages for local testing -- render.yaml
# explicitly overrides this to False for the real deployment, so this
# default is safe (it never applies to the internet-facing copy).
DEBUG=True
# 127.0.0.1/localhost work for local testing. For a real deployment, set
# this to your actual domain or server IP instead (render.yaml already
# does this for you automatically on Render).
ALLOWED_HOSTS=127.0.0.1,localhost

# Database
# DB_ENGINE=sqlite works immediately with zero setup -- use this for a
# first local test with "python manage.py runserver".
# Switch to DB_ENGINE=postgresql ONLY when running via docker-compose
# (docker-compose.yml sets DB_HOST=db for you automatically) -- "db" is
# not a real address outside Docker and manage.py runserver cannot use it.
DB_ENGINE=sqlite

# Uncomment and fill these in only when deploying with docker-compose or
# a real Postgres server:
# DB_ENGINE=postgresql
# DB_NAME=itam
# DB_USER=itam
# DB_PASSWORD=change-this-password
# DB_HOST=db
# DB_PORT=5432

# Shared secret each branch's install script embeds so only your own
# devices can self-register (security requirement -- rotate per branch
# if you want tighter control, see README "Security notes")
DEVICE_ENROLLMENT_KEY=EhSyzlxf83mNR8ktMvCUgDuvoNX3_4qAeTUmmP30T1k

# Minutes of silence before a device is shown as Offline in the dashboard
DEVICE_OFFLINE_AFTER_MINUTES=20

# Optional: email notifications for critical events (leave blank to disable)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
NOTIFY_EMAIL_ADDRESS=
